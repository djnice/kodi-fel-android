diff --git a/xbmc/platform/android/activity/XBMCApp.cpp b/xbmc/platform/android/activity/XBMCApp.cpp
index b1f265ef68..d8a99b0cbb 100644
--- a/xbmc/platform/android/activity/XBMCApp.cpp
+++ b/xbmc/platform/android/activity/XBMCApp.cpp
@@ -1579,6 +1579,25 @@ int64_t CXBMCApp::GetNextFrameTime() const
     return m_frameTimeNanos;
 }
 
+float CXBMCApp::GetMeasuredRefreshRate() const
+{
+  const int64_t period = m_vsyncPeriodNanos;
+  return period > 0 ? 1e9f / static_cast<float>(period) : 0.0f;
+}
+
+float CXBMCApp::GetDisplayRefreshRate()
+{
+  CJNIWindow window = getWindow();
+  if (!window)
+    return 0.0f;
+  CJNIView view = window.getDecorView();
+  CJNIDisplay display = view ? view.getDisplay() : CJNIDisplay();
+  if (!display)
+    return 0.0f;
+  CJNIDisplayMode mode = display.getMode();
+  return mode ? mode.getRefreshRate() : 0.0f;
+}
+
 float CXBMCApp::GetFrameLatencyMs() const
 {
   return (CurrentHostCounter() - m_frameTimeNanos) * 0.000001;
