diff --git a/xbmc/windowing/android/VideoSyncAndroid.cpp b/xbmc/windowing/android/VideoSyncAndroid.cpp
index f0e1d90cb2..361943b24f 100644
--- a/xbmc/windowing/android/VideoSyncAndroid.cpp
+++ b/xbmc/windowing/android/VideoSyncAndroid.cpp
@@ -19,6 +19,8 @@
 
 #include "platform/android/activity/XBMCApp.h"
 
+#include <cmath>
+
 bool CVideoSyncAndroid::Setup()
 {
   CLog::Log(LOGDEBUG, "CVideoSyncAndroid::{} setting up", __FUNCTION__);
@@ -49,6 +51,22 @@ void CVideoSyncAndroid::Cleanup()
 float CVideoSyncAndroid::GetFps()
 {
   m_fps = CServiceBroker::GetWinSystem()->GetGfxContext().GetFPS();
+  // the output mode may be switched outside Kodi (e.g. the auto frame rate of the Dune HD
+  // firmware): Kodi's mode is then wrong, and counting vblanks with it makes the clock
+  // jump (2 and 3 "vblanks" per 23.976 Hz callback at 59.94). Use the display's actual
+  // mode; the Choreographer rate decides if the two disagree.
+  const float display = CXBMCApp::Get().GetDisplayRefreshRate();
+  const float measured = CXBMCApp::Get().GetMeasuredRefreshRate();
+  float actual = display;
+  if (measured > 1.0f && (actual <= 1.0f || std::abs(actual - measured) > measured * 0.05f))
+    actual = measured;
+  if (actual > 1.0f && std::abs(actual - m_fps) > 0.01f)
+  {
+    CLog::Log(LOGINFO,
+              "CVideoSyncAndroid: the display runs at {:.3f} Hz (Kodi: {:.3f}, measured {:.3f})",
+              actual, m_fps, measured);
+    m_fps = actual;
+  }
   CLog::Log(LOGDEBUG, "CVideoSyncAndroid::{} Detected refreshrate: {:f} hertz", __FUNCTION__,
             m_fps);
   return m_fps;
@@ -73,4 +91,14 @@ void CVideoSyncAndroid::FrameCallback(int64_t frameTimeNanos)
 
   //update the vblank timestamp, update the clock and send a signal that we got a vblank
   m_refClock->UpdateClock(NrVBlanks, frameTimeNanos);
+
+  // the output mode changed under us: restart the clock with the new rate (GetFps)
+  const float measured = CXBMCApp::Get().GetMeasuredRefreshRate();
+  if (measured > 1.0f && std::abs(measured - m_fps) > m_fps * 0.05f && !m_restart)
+  {
+    m_restart = true;
+    CLog::Log(LOGINFO, "CVideoSyncAndroid: refresh rate changed to ~{:.3f} Hz (was {:.3f})",
+              measured, m_fps);
+    m_abortEvent.Set();
+  }
 }
